# VentureConnect Environment Configuration

# Application Security
SECRET_KEY=ventureconnect_secret_jwt_key_2026_super_secure

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ventureconnect

# CognoDB Cloud Managed Graph Database Connection
# 1. Sign up at https://console.cognodb.com
# 2. Create a free (c0) instance
# 3. Copy your URI (e.g. bolt+s://<instance-id>.databases.cognodb.cloud) and password for user "cognodb"
BOLT_URI=bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_USER=cognodb
COGNODB_PASSWORD=<your-generated-cognodb-password>
